    "Open EvaBar from the menu bar or press %@. Change the shortcut and launch at login in Preferences.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open EvaBar from the menu bar or press %@. Change the shortcut and launch at login in Preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单栏打开 EvaBar，或按 %@。可在偏好设置中更改快捷键和登录启动选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從選單列開啟 EvaBar，或按下 %@。可在偏好設定中變更快速鍵和登入啟動選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーから EvaBar を開くか、%@ を押してください。ショートカットやログイン時の起動は設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 EvaBar를 열거나 %@ 키를 누르세요. 환경설정에서 단축키와 로그인 시 실행을 변경할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne EvaBar über die Menüleiste oder drücke %@. Kurzbefehl und Start bei Anmeldung lassen sich in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez EvaBar depuis la barre des menus ou appuyez sur %@. Le raccourci et l’ouverture à la connexion se règlent dans les préférences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre EvaBar en la barra de menús o pulsa %@. Cambia el atajo y el inicio de sesión en Preferencias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o EvaBar pela barra de menus ou pressione %@. Altere o atalho e a abertura ao iniciar sessão nas Preferências."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri EvaBar dalla barra dei menu o premi %@. Modifica l’abbreviazione e l’avvio al login nelle preferenze."
          }
        }
      }
    },
    "Open EvaBar from the menu bar. You can set a shortcut and enable launch at login in Preferences.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open EvaBar from the menu bar. You can set a shortcut and enable launch at login in Preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单栏打开 EvaBar。可在偏好设置中设置快捷键并启用登录启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從選單列開啟 EvaBar。可在偏好設定中設定快速鍵並啟用登入時啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーから EvaBar を開けます。設定でショートカットを登録し、ログイン時の起動を有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 EvaBar를 여세요. 환경설정에서 단축키를 지정하고 로그인 시 실행을 켤 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne EvaBar über die Menüleiste. In den Einstellungen kannst du einen Kurzbefehl festlegen und den Start bei Anmeldung aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez EvaBar depuis la barre des menus. Vous pouvez définir un raccourci et activer l’ouverture à la connexion dans les préférences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre EvaBar en la barra de menús. En Preferencias puedes configurar un atajo y abrir la app al iniciar sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o EvaBar pela barra de menus. Nas Preferências, você pode definir um atalho e ativar a abertura ao iniciar sessão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri EvaBar dalla barra dei menu. Nelle preferenze puoi impostare un’abbreviazione e attivare l’avvio al login."
          }
        }
      }
    },
