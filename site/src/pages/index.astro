---
import { ArrowRight, ChevronDown, Keyboard, LaptopMinimal, Pin, SlidersHorizontal } from "lucide-react";
import screenshot from "../../../docs/images/evabar-bar.png";
import { CalculatorPreview } from "@/components/calculator-preview";
import FAQ from "@/components/FAQ.astro";
import { buttonVariants } from "@/components/ui/button";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getMacDownloads, releasesUrl, repositoryUrl } from "@/lib/release";
import { resourcePages, resources } from "@/lib/resources";

const { arm64, intel } = await getMacDownloads() ?? {};
const hasDownloads = Boolean(arm64 || intel);
const differentVersions = arm64 && intel && arm64.version !== intel.version;
const release = differentVersions ? undefined : arm64 ?? intel;
const releaseNotesUrl = release?.releaseUrl ?? releasesUrl;
const downloadOptions = arm64 && arm64.url === intel?.url ? [
  { label: "Universal", architecture: "Apple silicon and Intel", download: arm64 },
] : [
  { label: "Apple silicon", architecture: "ARM64", download: arm64 },
  { label: "Intel", architecture: "x86_64", download: intel },
];
const downloadUrls = downloadOptions.flatMap(({ download }) => download ? [download.url] : []);
const hasPrereleaseDownload = downloadOptions.some(({ download }) => download?.prerelease);
const betaInstallUrl = `${resources.floating.path}#open-beta`;
const chipSupport = [arm64 ? "Apple silicon" : null, intel ? "Intel" : null].filter(Boolean).join(" and ") || null;
const title = "Eva|Bar — Free Menu Bar Calculator for Mac";
const description = "Eva|Bar, formerly CalcBar2, is a free, open-source menu bar calculator for Mac. Open it with a global shortcut and press Return to copy the result.";
const canonical = new URL("/", Astro.site).href;
const guidesAndComparisons = resourcePages.filter((page) => page.path !== resources.features.path);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Eva|Bar",
  alternateName: "CalcBar2",
  url: canonical,
  description,
  operatingSystem: "macOS 13 or later",
  applicationCategory: "UtilitiesApplication",
  isAccessibleForFree: true,
  screenshot: new URL(screenshot.src, canonical).href,
  downloadUrl: downloadUrls.length ? downloadUrls : releasesUrl,
  softwareVersion: release?.version,
  license: `${repositoryUrl}/blob/main/LICENSE`,
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD", url: releaseNotesUrl },
};
const features = [
  { icon: Keyboard, heading: "Always a shortcut away", description: "Open the floating bar from any app, type your expression, and press Return to copy the result." },
  { icon: Pin, heading: "Keep it in view", description: "Click the lock to keep Eva|Bar above your workspace. Unlock it to dismiss the bar by clicking anywhere else." },
  { icon: SlidersHorizontal, heading: "Numbers on your terms", description: "Set the decimal precision and choose your decimal and thousands separators in Preferences." },
];
---
<SiteLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <img class="hero-icon" src="/images/evabar-icon.png" alt="" width="85" height="85" />
      <p class="eyebrow">Do the math. Stay in flow.</p>
      <h1 id="hero-title">Menu bar calculator <br /><span>for Mac.</span></h1>
      <p class="hero-description">Eva|Bar, formerly CalcBar2, is free and open source. Open the floating calculator with a global shortcut, type an expression, and press Return to copy the result.</p>
      <div class="hero-actions" id="download">
        {hasDownloads ? (
          <details class="download-menu" id="mac-downloads">
            <summary class={buttonVariants({ size: "lg", class: "download-button" })}>
              <LaptopMinimal aria-hidden="true" /> Download for Mac <ChevronDown className="download-chevron" aria-hidden="true" />
            </summary>
            <ul class="download-options">
              {downloadOptions.map(({ label, architecture, download }) => (
                <li>
                  {download ? (
                    <a class="download-option" href={download.url}>
                      <span class="download-platform">{label}<small>{architecture}</small></span>
                      <small class="download-version">{download.version}</small>
                    </a>
                  ) : (
                    <span class="download-option download-unavailable">
                      {label}<small>Unavailable</small>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a class={buttonVariants({ size: "lg", class: "download-button" })} href={releasesUrl}>
            <LaptopMinimal aria-hidden="true" /> View Mac downloads
          </a>
        )}
        {hasDownloads && <a class={buttonVariants({ size: "lg", variant: "outline" })} href={releaseNotesUrl}>Release notes</a>}
      </div>
      <p class="requirements"><span>macOS 13+</span>{chipSupport && <span>{chipSupport}</span>}{release && <span>{release.version}</span>}</p>
      {hasPrereleaseDownload && (
        <p class="download-note">
          <strong>Beta downloads</strong> are distributed without an Apple Developer ID signature or notarization.
          <a href={betaInstallUrl}>How to open the beta</a>
        </p>
      )}
    </div>
    <div id="preview" class="preview-anchor">
      <CalculatorPreview client:load />
    </div>
  </section>

  <section id="features" class="shell content-section" aria-labelledby="features-title">
    <p class="eyebrow">Features</p>
    <h2 id="features-title">A little bar that does a lot.</h2>
    <div class="feature-grid">
      {features.map(({ icon: Icon, heading, description }) => (
        <article class="feature-card">
          <span class="feature-icon"><Icon size={20} strokeWidth={1.7} aria-hidden="true" /></span>
          <h3>{heading}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
    <a class="feature-details-link" href={resources.features.path}>See all features and preferences <ArrowRight size={16} aria-hidden="true" /></a>
  </section>

  <section id="quick-start" class="shell content-section guide" aria-labelledby="guide-title">
    <div>
      <p class="eyebrow">Quick start</p>
      <h2 id="guide-title">One shortcut.<br />Any workspace.</h2>
      <div class="key-chord" role="group" aria-label="Control, Shift, Space">
        <kbd aria-hidden="true">⌃</kbd><kbd aria-hidden="true">⇧</kbd><kbd aria-hidden="true">Space</kbd>
      </div>
    </div>
    <ol class="guide-steps">
      <li><span>1</span><div><h3>Install Eva|Bar</h3><p>Unzip the download and move the app to your Applications folder.{hasPrereleaseDownload && <> If macOS blocks the beta, see <a href={betaInstallUrl}>first-launch instructions</a>.</>}</p></div></li>
      <li><span>2</span><div><h3>Open the bar</h3><p>Click Eva|Bar in the menu bar or press Control–Shift–Space.</p></div></li>
      <li><span>3</span><div><h3>Type and copy</h3><p>Enter a calculation and press Return to copy the result.</p></div></li>
    </ol>
  </section>

  <section class="shell content-section questions" aria-labelledby="questions-title">
    <h2 id="questions-title">Common questions</h2>
    <FAQ chipSupport={chipSupport} releaseNotesUrl={releaseNotesUrl} />
  </section>

  <section id="resources" class="shell content-section resources" aria-labelledby="resources-title">
    <h2 id="resources-title">Guides and comparisons</h2>
    <ul class="resource-grid">
      {guidesAndComparisons.map((page) => (
        <li>
          <a class="resource-card" href={page.path}>
            <div><h3>{page.heading}</h3><p>{page.description}</p></div>
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>

<script>
  const downloads = document.querySelector<HTMLDetailsElement>("#mac-downloads");
  const trigger = downloads?.querySelector("summary");
  if (downloads && trigger) {
    document.addEventListener("click", (event) => {
      if (downloads.open && event.target instanceof Node && !downloads.contains(event.target)) {
        downloads.open = false;
      }
    });
    downloads.addEventListener("keydown", (event) => {
      if (downloads.open && event.key === "Escape") {
        downloads.open = false;
        trigger.focus();
      }
    });
  }
</script>
