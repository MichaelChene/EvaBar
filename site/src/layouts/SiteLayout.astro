---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles.css";
import { CodeXml } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { releasesUrl, repositoryUrl } from "@/lib/release";
import { resources } from "@/lib/resources";

interface Props {
  title: string;
  description: string;
  path: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, path, structuredData } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const shareImage = new URL("/images/evabar-social.jpg", canonical).href;
const isHome = path === "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120f12" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:site_name" content="Eva|Bar" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eva|Bar for Mac, with the floating calculator bar visible over the desktop" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/evabar-icon.png" />
    <link rel="apple-touch-icon" href="/images/evabar-icon.png" />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={isHome ? "#top" : "/"} aria-label="Eva|Bar home">
          <img src="/images/evabar-icon.png" alt="" width="32" height="32" />
          <span>Eva<span class="brand-divider">|</span>Bar</span>
        </a>
        <nav class="primary-nav" aria-label="Main navigation">
          <a href="/#preview">Preview</a>
          <a href={resources.features.path} aria-current={path === resources.features.path ? "page" : undefined}>Features</a>
          <a href="/#quick-start">Quick start</a>
          <a href="/#resources">Resources</a>
        </nav>
        <a class={buttonVariants({ variant: "ghost", class: "header-source" })} href={repositoryUrl}>
          <CodeXml aria-hidden="true" /> GitHub
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand" href={isHome ? "#top" : "/"} aria-label="Eva|Bar home">
          <img src="/images/evabar-icon.png" alt="" width="30" height="30" />
          <span>Eva<span class="brand-divider">|</span>Bar</span>
        </a>
        <nav aria-label="Footer navigation">
          <a href={releasesUrl}>Releases</a>
          <a href={`${repositoryUrl}/issues`}>Issues</a>
          <a href={`${repositoryUrl}/blob/main/LICENSE`}>MIT License</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
