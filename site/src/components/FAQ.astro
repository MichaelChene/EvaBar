---
import { ChevronDown } from "lucide-react";

interface Props {
  chipSupport: string | null;
  releaseNotesUrl: string;
}

const { chipSupport, releaseNotesUrl } = Astro.props;
---

<div class="faq-list">
  <details name="evabar-faq">
    <summary>
      Which Macs can run EvaBar?
      <ChevronDown size={16} aria-hidden="true" />
    </summary>
    <p>
      EvaBar requires macOS 13 or later.
      {chipSupport
        ? `Downloads are available for ${chipSupport} Macs.`
        : <>See the <a href={releaseNotesUrl}>release notes</a> for supported Mac models.</>}
    </p>
  </details>
  <details name="evabar-faq">
    <summary>
      How do I write expressions?
      <ChevronDown size={16} aria-hidden="true" />
    </summary>
    <p>
      Use a period for decimal numbers, commas between function arguments, and radians for trigonometry.
      Try <code>avg(12,18,24)</code> or <code>sin(pi / 2)</code>. Open the <strong>f</strong> panel to see available functions.
    </p>
  </details>
  <details name="evabar-faq">
    <summary>
      Which languages are available?
      <ChevronDown size={16} aria-hidden="true" />
    </summary>
    <p>
      EvaBar follows your system language by default. Choose English, Simplified Chinese, Traditional Chinese,
      Japanese, Korean, German, French, Spanish, Brazilian Portuguese, or Italian in Preferences.
    </p>
  </details>
</div>
